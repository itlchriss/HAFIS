#!/bin/bash
#
# MEARC - Meaning Extraction and Annotation for Refinement Contracts
# 
# Usage: mearc [OPTIONS] <input_file>
#
# Options:
#   -b, --backend <jml|dafny|auto>   Select output backend (default: auto)
#                                     auto: detect from file extension
#                                           .java -> jml, .dfy -> dafny
#   -m, --mode <mode>           Operation mode:
#                                 full     - Run all stages (default)
#                                 preproc  - Text preprocessing/extraction only
#                                 mrderive - MR derivation with preprocessing
#                                 compile  - Compilation only
#   -o, --output <file>         Output file (default: auto-generated)
#   -h, --help                  Show this help message
#
# Supported Input Files:
#   .java - Extracts JML conditions, translates to JML specifications
#   .dfy  - Extracts NL annotations from Dafny code, translates and instruments
#   .mr   - Compiles MR directly to specifications
#
# Dafny NL Annotation Syntax (in .dfy files):
#   // requires(*natural language*);   -> requires clause
#   // ensures(*natural language*);    -> ensures clause  
#   // assert(*natural language*);     -> assert statement
#

set -e  # Exit on error

# ============================================================================
# Configuration
# ============================================================================
ROOT=./
NLP=../NLP/ccg2lambda
STD_SI=./specs/si/typed_si.yml,./specs/si/java_datatypes.yml
PYCMD=../venv/mearc/bin/python3
TMP=./tmp
OPENJML=../openjml-0.17-a15

# Backend-specific SI configurations (using function for bash 3.2 compatibility)
get_backend_si() {
    case "$BACKEND" in
        dafny) echo "$STD_SI" ;;
        jml)   echo "$STD_SI" ;;
        *)     echo "$STD_SI" ;;
    esac
}

# ============================================================================
# Default Settings
# ============================================================================
BACKEND="auto"
MODE="full"
OUTPUT_FILE=""

# ============================================================================
# Helper Functions
# ============================================================================
usage() {
    cat << EOF
MEARC - Meaning Extraction and Annotation for Refinement Contracts

Usage: $(basename "$0") [OPTIONS] <input_file>

Options:
    -b, --backend <jml|dafny|auto>   Select output backend (default: auto)
                                     auto: detect from file extension
                                           .java -> jml, .dfy -> dafny
    -m, --mode <mode>           Operation mode:
                                  full     - Run all stages (default)
                                  preproc  - Text preprocessing/extraction only
                                  mrderive - MR derivation with preprocessing
                                  compile  - Compilation only
    -o, --output <file>         Output file (default: auto-generated)
    -h, --help                  Show this help message

Supported Inputs:
    .java    Extract JML conditions -> translate to JML specs
    .dfy     Extract NL annotations -> translate and instrument into Dafny code
    .mr      Compile MR directly to specs

Dafny NL Annotation Syntax (in .dfy files):
    // requires(*natural language*);   Translated to: requires <dafny_expr>
    // ensures(*natural language*);    Translated to: ensures <dafny_expr>
    // assert(*natural language*);     Translated to: assert <dafny_expr>;

Examples:
    $(basename "$0") test/example.java           # auto -> jml
    $(basename "$0") test/example.dfy            # auto -> dafny, instruments code
    $(basename "$0") -b dafny test/example.java  # force dafny backend
    $(basename "$0") -m compile test/example.dfy # compile only
EOF
    exit 0
}

log_info() {
    echo "[INFO] $1"
}

log_error() {
    echo "[ERROR] $1" >&2
}

# Format output based on backend
format_output() {
    local keyword="$1"
    local body="$2"
    local backend="$3"
    
    if [ "$backend" = "dafny" ]; then
        echo "$keyword $body"
    else
        echo "$keyword($body);"
    fi
}

# Get output directory based on backend
get_output_dir() {
    local folder="$1"
    local backend="$2"
    echo "$folder/$backend"
}

# Get output file extension based on backend
get_output_extension() {
    local backend="$1"
    if [ "$backend" = "dafny" ]; then
        echo "dfy"
    else
        echo "jml"
    fi
}

# Check if a file is non-empty and contains more than whitespace
file_has_content() {
    local file="$1"
    if [[ ! -f "$file" ]]; then
        return 1
    fi
    if grep -qE '[^[:space:]]' "$file" 2>/dev/null; then
        return 0
    fi
    return 1
}

# Detect backend from file extension
detect_backend() {
    local file="$1"
    case "$file" in
        *.java) echo "jml" ;;
        *.dfy)  echo "dafny" ;;
        *)      echo "jml" ;;
    esac
}

# Detect input file type
detect_input_type() {
    local file="$1"
    case "$file" in
        *.java) echo "java" ;;
        *.dfy)  echo "dfy" ;;
        *.mr)   echo "mr" ;;
        *)      echo "unknown" ;;
    esac
}

# Extract NL text from a Dafny annotation comment
extract_annotation_text() {
    local line="$1"
    local keyword="$2"
    if [[ "$line" =~ //[[:space:]]*${keyword}\(\*([^*]+)\*\)[[:space:]]*\; ]]; then
        echo "${BASH_REMATCH[1]}"
        return 0
    fi
    return 1
}



# ============================================================================
# NLP Pipeline and Compilation
# ============================================================================

# Run the NLP pipeline on a text to produce an MR file
run_nlp_pipeline() {
    local text="$1"
    local basename="$2"

    echo "${basename}.tok"
    
    # Step 1: Tokenize (ensure newline at end for ccg2lambda)
    printf '%s\n' "$text" | sed -f "$NLP/en/tokenizer.sed" > "${basename}.tok"
    
    # Step 2: C&C parsing
    # $NLP/en/candc-1.00/bin/candc --models "$NLP/en/candc-1.00/models" \
    #     --candc-printer xml \
    #     --candc-maxwords 2048 \
    #     --input "${basename}.tok" > "${basename}.candc.xml" 2>/dev/null
    $NLP/candc-1.00/bin/candc --models "$NLP/candc-1.00/models" \
        --candc-printer xml \
        --candc-maxwords 2048 \
        --input "${basename}.tok" > "${basename}.candc.xml"
    
    # Step 3: Convert to CCG
    $PYCMD "$NLP/en/candc2transccg_wsc.py" "${basename}.candc.xml" > "${basename}.ccg.xml"
    
    # Step 4: Semantic parsing to MR
    $PYCMD "$NLP/scripts/semparse_wsc.py" "${basename}.ccg.xml" \
        "$NLP/en/semantic_templates_en_event_flat_mearc.yaml" --ncores 1 > "${basename}.mr"
    
    # Step 5: Normalize MR
    $PYCMD ./src/python/depccg/nltk2normal.py "${basename}.mr" 2>/dev/null || true
    
    echo "${basename}.mr"
}

# Compile an MR file and extract the body
compile_mr() {
    local mr_file="$1"
    local backend="$2"
    local si_config="$3"
    
    local cmd="./bin/main -f $mr_file -s $si_config -b $backend"
    
    # Add dynamic SI if available
    local mr_dir=$(dirname "$mr_file")
    local mr_name=$(basename "$mr_file" .mr)
    if [[ -f "$mr_dir/dynamic_si.$mr_name.yml" ]]; then
        cmd="$cmd,$mr_dir/dynamic_si.$mr_name.yml"
    fi
    
    local ans
    ans=$(eval "$cmd" 2>&1)
    
    # Check for errors
    if [[ "$ans" == *"error"* || "$ans" == *"Lexer:"* || "$ans" == *"Parser:"* ]]; then
        log_error "Compilation failed for $(basename "$mr_file"):"
        echo "$ans"
        return 1
    fi
    
    # Parse output
    if [[ -n "$ans" ]]; then
        IFS=$'\n' read -rd '' -a lines <<< "$ans" || true
        local line1="${lines[0]}"
        
        if [[ "$line1" =~ pcount:([0-9]+) ]]; then
            local pcount="${BASH_REMATCH[1]}"
            for i in $(seq 1 "$pcount"); do
                local body="${lines[$i]}"
                if [[ "$backend" == "jml" ]]; then
                    body="${body/\\ /\\}"
                fi
                if [[ -n "$body" && "$body" != "()" ]]; then
                    echo "$body"
                fi
            done
            return 0
        fi
    fi
    
    return 1
}

# ============================================================================
# Annotation Table (Unified for all input types)
# ============================================================================
declare -a TBL_INDEX       # Annotation ID
declare -a TBL_LINE        # Source line number (or 0 for non-source)
declare -a TBL_TYPE        # requires/ensures/assert
declare -a TBL_TEXT        # NL text
declare -a TBL_INDENT      # Leading whitespace
declare -a TBL_METHOD      # Enclosing method name (for Dafny)
declare -a TBL_MR          # MR file path
declare -a TBL_PREPROC     # Preprocessed text
declare -a TBL_TRANS       # Translated output
declare -a TBL_STATUS      # pending/preprocessed/mr_ready/translated/failed

TBL_COUNT=0

# Add an entry to the annotation table
tbl_add() {
    local line_num="$1"
    local type="$2"
    local text="$3"
    local indent="${4:-}"
    local method="${5:-__global__}"
    
    TBL_INDEX[$TBL_COUNT]=$TBL_COUNT
    TBL_LINE[$TBL_COUNT]="$line_num"
    TBL_TYPE[$TBL_COUNT]="$type"
    TBL_TEXT[$TBL_COUNT]="$text"
    TBL_INDENT[$TBL_COUNT]="$indent"
    TBL_METHOD[$TBL_COUNT]="$method"
    TBL_MR[$TBL_COUNT]="$MR_DIR/ann.${TBL_COUNT}.${type}.mr"
    TBL_PREPROC[$TBL_COUNT]=""
    TBL_TRANS[$TBL_COUNT]=""
    TBL_STATUS[$TBL_COUNT]="pending"
    
    TBL_COUNT=$((TBL_COUNT + 1))
}

# Print the annotation table
tbl_print() {
    log_info "Annotation Table ($TBL_COUNT entries):"
    log_info "  ID  Line  Type      Method           Status        NL Text"
    log_info "  --- ----  --------  ---------------  ------------  -------"
    for i in $(seq 0 $((TBL_COUNT - 1))); do
        printf "  %-3s %-5s %-9s %-16s %-13s %s\n" \
            "${TBL_INDEX[$i]}" "${TBL_LINE[$i]}" "${TBL_TYPE[$i]}" \
            "${TBL_METHOD[$i]}" "${TBL_STATUS[$i]}" "${TBL_TEXT[$i]}"
    done
}

# ============================================================================
# Stage 1: Extraction Functions (Input-Type-Specific)
# ============================================================================

# Main extraction dispatcher
extract_annotations() {
    log_info "Stage 1: Extracting annotations from $INPUT_TYPE file..."
    mkdir -p "$MR_DIR"
    
    case "$INPUT_TYPE" in
        dfy)  extract_from_dafny ;;
        java) extract_from_java ;;
        mr)   extract_from_mr ;;
        *)    log_error "Unknown input type: $INPUT_TYPE"; return 1 ;;
    esac
}

# Extract from Dafny NL annotations
# In Dafny, requires/ensures appear BEFORE the method they belong to,
# so we need to look FORWARD to find the associated method.
extract_from_dafny() {
    # First pass: collect all method declarations and their line numbers
    declare -a METHOD_LINES
    declare -a METHOD_NAMES
    local method_count=0
    local line_num=0
    
    while IFS= read -r line; do
        line_num=$((line_num + 1))
        if [[ "$line" =~ ^[[:space:]]*method[[:space:]]+([a-zA-Z_][a-zA-Z0-9_]*) ]]; then
            METHOD_LINES[$method_count]=$line_num
            METHOD_NAMES[$method_count]="${BASH_REMATCH[1]}"
            method_count=$((method_count + 1))
        fi
    done < "$INPUT_FILE"
    
    # Helper function to find the method that follows a given line
    find_following_method() {
        local annotation_line="$1"
        local i=0
        while [[ $i -lt $method_count ]]; do
            if [[ ${METHOD_LINES[$i]} -gt $annotation_line ]]; then
                echo "${METHOD_NAMES[$i]}"
                return
            fi
            i=$((i + 1))
        done
        # No method found after this line, use __global__
        echo "__global__"
    }
    
    # Second pass: extract annotations and associate with following method
    line_num=0
    while IFS= read -r line; do
        line_num=$((line_num + 1))
        
        # Check for each annotation type
        for keyword in requires ensures assert; do
            if nl_text=$(extract_annotation_text "$line" "$keyword"); then
                local indent=""
                if [[ "$line" =~ ^([[:space:]]*) ]]; then
                    indent="${BASH_REMATCH[1]}"
                fi
                
                # Find the method that follows this annotation
                local associated_method
                associated_method=$(find_following_method $line_num)
                
                tbl_add "$line_num" "$keyword" "$nl_text" "$indent" "$associated_method"
                log_info "  [${TBL_COUNT}] Line $line_num ($associated_method): $keyword(*$nl_text*)"
            fi
        done
    done < "$INPUT_FILE"
    
    log_info "Found $TBL_COUNT annotation(s)"
    
    if [[ $TBL_COUNT -eq 0 ]]; then
        log_error "No NL annotations found in $INPUT_FILE"
        return 1
    fi
    return 0
}

# Extract from Java conditions.yml
extract_from_java() {
    # Run preprocessing first to generate conditions.yml
    log_info "  Running text preprocessing..."
    $PYCMD ./src/python/textpreprocessing.py "$INPUT_FILE"
    
    if [[ ! -f "$MR_DIR/conditions.yml" ]]; then
        log_error "conditions.yml not generated in $MR_DIR"
        return 1
    fi
    
    # Parse ensures conditions
    local i=0
    IFS=$'\n'
    for condition in $(niet ".ensures" "$MR_DIR/conditions.yml" 2>/dev/null || echo ""); do
        if [[ -z "$condition" || "$condition" == "Element not found: ensures" ]]; then
            break
        fi
        tbl_add 0 "ensures" "$condition" "" "__global__"
        TBL_MR[$((TBL_COUNT-1))]="$MR_DIR/post.$i.mr"
        log_info "  [ensures.$i] $condition"
        i=$((i + 1))
    done
    
    # Parse requires conditions
    i=0
    for condition in $(niet ".requires" "$MR_DIR/conditions.yml" 2>/dev/null || echo ""); do
        if [[ -z "$condition" || "$condition" == "Element not found: requires" ]]; then
            break
        fi
        tbl_add 0 "requires" "$condition" "" "__global__"
        TBL_MR[$((TBL_COUNT-1))]="$MR_DIR/pre.$i.mr"
        log_info "  [requires.$i] $condition"
        i=$((i + 1))
    done
    IFS=$' \t\n'
    
    log_info "Found $TBL_COUNT condition(s)"
    
    if [[ $TBL_COUNT -eq 0 ]]; then
        log_error "No conditions found in $INPUT_FILE"
        return 1
    fi
    return 0
}

# Extract from existing MR files
extract_from_mr() {
    local mr_count=0
    
    for mr_file in "$MR_DIR/"*.mr; do
        if [[ -f "$mr_file" ]] && file_has_content "$mr_file"; then
            local mr_name=$(basename "$mr_file" .mr)
            local keyword="ensures"
            if [[ "$mr_name" == *"pre"* ]]; then
                keyword="requires"
            fi
            
            # Read MR content as text (will be used directly)
            local content=$(cat "$mr_file")
            tbl_add 0 "$keyword" "$content" "" "__global__"
            TBL_MR[$((TBL_COUNT-1))]="$mr_file"
            TBL_PREPROC[$((TBL_COUNT-1))]="$content"
            TBL_STATUS[$((TBL_COUNT-1))]="mr_ready"
            
            log_info "  [$mr_name] $keyword: $content"
            mr_count=$((mr_count + 1))
        fi
    done
    
    log_info "Found $mr_count MR file(s)"
    
    if [[ $mr_count -eq 0 ]]; then
        log_error "No valid MR files found in $MR_DIR"
        return 1
    fi
    return 0
}

# ============================================================================
# Stage 2: Preprocessing Function (Unified)
# ============================================================================
preprocess_annotations() {
    log_info "Stage 2: Preprocessing $TBL_COUNT annotation(s)..."
    
    for i in $(seq 0 $((TBL_COUNT - 1))); do
        # Skip if already preprocessed or MR ready
        if [[ "${TBL_STATUS[$i]}" != "pending" ]]; then
            continue
        fi
        
        local text="${TBL_TEXT[$i]}"
        local type="${TBL_TYPE[$i]}"
        local mr_base="${TBL_MR[$i]%.mr}"
        
        log_info "  [$i] $type: \"$text\""
        
        if [[ "$INPUT_TYPE" == "dfy" ]]; then
            # Use preprocess_annotation.py for Dafny
            local ann_id="$(basename "${mr_base}")"
            local preprocessed
            preprocessed=$($PYCMD ./preprocess_annotation.py "$text" "$type" "$MR_DIR" "$ann_id" 2>/dev/null)
            
            if [[ -z "$preprocessed" ]]; then
                log_error "      Preprocessing failed"
                TBL_STATUS[$i]="failed"
                continue
            fi
            
            TBL_PREPROC[$i]="$preprocessed"
            TBL_STATUS[$i]="preprocessed"
            log_info "      Preprocessed: \"$preprocessed\""
        else
            # For Java, use text directly (already preprocessed by textpreprocessing.py)
            TBL_PREPROC[$i]="$text"
            TBL_STATUS[$i]="preprocessed"
            log_info "      Using text directly"
        fi
    done
    
    return 0
}

# ============================================================================
# Stage 3: MR Derivation Function (Unified)
# ============================================================================
derive_mrs() {
    log_info "Stage 3: MR derivation for $TBL_COUNT annotation(s)..."
    
    for i in $(seq 0 $((TBL_COUNT - 1))); do
        # # Skip if MR already ready or failed
        # if [[ "${TBL_STATUS[$i]}" == "mr_ready" || "${TBL_STATUS[$i]}" == "failed" ]]; then
        #     continue
        # fi
        
        # Skip if not preprocessed
        if [[ "${TBL_STATUS[$i]}" != "preprocessed" ]]; then
            log_error "  [$i] Skipping (not preprocessed)"
            TBL_STATUS[$i]="failed"
            continue
        fi
        
        local preprocessed="${TBL_PREPROC[$i]}"
        local mr_base="${TBL_MR[$i]%.mr}"
        
        log_info "  [$i] Running NLP pipeline..."
        
        # Run NLP pipeline
        if run_nlp_pipeline "$preprocessed" "$mr_base" > /dev/null 2>&1; then
            if [[ -f "${mr_base}.mr" ]] && file_has_content "${mr_base}.mr"; then
                local mr_content=$(cat "${mr_base}.mr")
                log_info "      MR: $mr_content"
                TBL_STATUS[$i]="mr_ready"
            elif [[ -f "${mr_base}.mr" ]]; then
                log_error "      MR file is empty or contains only whitespace"
                TBL_STATUS[$i]="failed"
            else
                log_error "      MR file not generated"
                TBL_STATUS[$i]="failed"
            fi
        else
            log_error "      NLP pipeline failed"
            TBL_STATUS[$i]="failed"
        fi
    done
    
    # Count successful MR derivations
    local mr_ready_count=0
    for i in $(seq 0 $((TBL_COUNT - 1))); do
        if [[ "${TBL_STATUS[$i]}" == "mr_ready" ]]; then
            mr_ready_count=$((mr_ready_count + 1))
        fi
    done
    
    if [[ $mr_ready_count -eq 0 ]]; then
        log_error "Stage 3 FAILED: No MR files were produced"
        log_error "Possible causes:"
        log_error "  - NLP pipeline (ccg2lambda) is not available at $NLP"
        log_error "  - NLP pipeline failed during processing"
        log_error "  - Preprocessing failed for all annotations"
        return 1
    fi
    
    log_info "Stage 3 complete: $mr_ready_count/$TBL_COUNT annotation(s) have MR files"
    return 0
}

# ============================================================================
# Stage 4: Compilation Function (Unified)
# ============================================================================
compile_annotations() {
    log_info "Stage 4: Compiling $TBL_COUNT annotation(s) (backend: $BACKEND)..."
    
    local si_config=$(get_backend_si)
    
    for i in $(seq 0 $((TBL_COUNT - 1))); do
        local type="${TBL_TYPE[$i]}"
        local mr_file="${TBL_MR[$i]}"
        local indent="${TBL_INDENT[$i]}"
        
        # Skip if MR wasn't generated
        if [[ "${TBL_STATUS[$i]}" != "mr_ready" ]]; then
            log_info "  [$i] Skipping (MR not ready)"
            continue
        fi
        
        # Check MR file exists
        if [[ ! -f "$mr_file" ]]; then
            log_error "  [$i] MR file not found: $mr_file"
            TBL_STATUS[$i]="failed"
            continue
        fi
        
        log_info "  [$i] $type..."
        
        # Compile the MR
        local bodies
        if bodies=$(compile_mr "$mr_file" "$BACKEND" "$si_config"); then
            local translated=""
            while IFS= read -r body; do
                if [[ -n "$body" ]]; then
                    if [[ "$INPUT_TYPE" == "dfy" && "$type" == "assert" ]]; then
                        translated+="${indent}assert ${body};"$'\n'
                    else
                        translated+="${indent}${type} ${body}"$'\n'
                    fi
                fi
            done <<< "$bodies"
            
            if [[ -n "$translated" ]]; then
                translated="${translated%$'\n'}"
                TBL_TRANS[$i]="$translated"
                TBL_STATUS[$i]="translated"
                log_info "      -> $(echo "$translated" | head -1)"
            else
                log_error "      No output from compilation"
                TBL_STATUS[$i]="failed"
            fi
        else
            log_error "      Compilation failed"
            TBL_STATUS[$i]="failed"
        fi
    done
    
    # Count successful translations
    local translated_count=0
    for i in $(seq 0 $((TBL_COUNT - 1))); do
        if [[ "${TBL_STATUS[$i]}" == "translated" ]]; then
            translated_count=$((translated_count + 1))
        fi
    done
    
    if [[ $translated_count -eq 0 ]]; then
        log_error "Stage 4 FAILED: No annotations were successfully compiled"
        return 1
    fi
    
    log_info "Stage 4 complete: $translated_count/$TBL_COUNT annotation(s) translated"
    return 0
}

# ============================================================================
# Stage 5: Output Functions (Input-Type-Specific)
# ============================================================================
output_results() {
    log_info "Stage 5: Outputting results..."
    
    case "$INPUT_TYPE" in
        dfy)  output_dafny ;;
        java) output_java ;;
        mr)   output_mr ;;
    esac
}

# Output for Dafny: Instrument the source file
output_dafny() {
    log_info "  Instrumenting Dafny file..."
    
    # Build list of annotation lines to skip
    local skip_lines=""
    for i in $(seq 0 $((TBL_COUNT - 1))); do
        if [[ "${TBL_STATUS[$i]}" == "translated" ]]; then
            skip_lines="$skip_lines ${TBL_LINE[$i]}"
        fi
    done
    
    # Helper function to check if line should be skipped
    should_skip_line() {
        local line_num="$1"
        for sl in $skip_lines; do
            if [[ "$sl" == "$line_num" ]]; then
                return 0
            fi
        done
        return 1
    }
    
    # Helper function to output annotations for a method
    output_annotations_for_method() {
        local target_method="$1"
        for i in $(seq 0 $((TBL_COUNT - 1))); do
            if [[ "${TBL_STATUS[$i]}" == "translated" ]]; then
                local method="${TBL_METHOD[$i]}"
                local type="${TBL_TYPE[$i]}"
                local trans="${TBL_TRANS[$i]}"
                
                if [[ "$method" == "$target_method" && "$type" != "assert" ]]; then
                    while IFS= read -r t; do
                        [[ -n "$t" ]] && echo "    $t"
                    done <<< "$trans"
                fi
            fi
        done
    }
    
    local line_num=0
    local current_method=""
    {
        while IFS= read -r line || [[ -n "$line" ]]; do
            line_num=$((line_num + 1))
            
            if should_skip_line "$line_num"; then
                continue
            fi
            
            if [[ "$line" =~ ^[[:space:]]*method[[:space:]]+([a-zA-Z_][a-zA-Z0-9_]*) ]]; then
                current_method="${BASH_REMATCH[1]}"
                echo "$line"
                
                # Output requires/ensures for this method and __global__
                output_annotations_for_method "$current_method"
                output_annotations_for_method "__global__"
            else
                echo "$line"
            fi
        done < "$INPUT_FILE"
    } > "${OUTPUT_FILE}.tmp"
    
    mv "${OUTPUT_FILE}.tmp" "$OUTPUT_FILE"
    log_info "  Output written to: $OUTPUT_FILE"
}

# Output for Java: Write JML files
output_java() {
    log_info "  Writing JML specification files..."
    
    mkdir -p "$output_dir"
    
    for i in $(seq 0 $((TBL_COUNT - 1))); do
        if [[ "${TBL_STATUS[$i]}" != "translated" ]]; then
            continue
        fi
        
        local mr_file="${TBL_MR[$i]}"
        local mr_name=$(basename "$mr_file" .mr)
        local type="${TBL_TYPE[$i]}"
        local trans="${TBL_TRANS[$i]}"
        
        local output_file="$output_dir/$mr_name.$output_ext"
        > "$output_file"
        
        while IFS= read -r body; do
            if [[ -n "$body" ]]; then
                local keyword="$type"
                if [[ "$body" == *"result"* ]]; then
                    keyword="ensures"
                fi
                local formatted=$(format_output "$keyword" "$body" "$BACKEND")
                echo "$formatted"
                echo "$formatted" >> "$output_file"
            fi
        done <<< "$trans"
        
        log_info "    Output: $output_file"
    done
}

# Output for MR: Write spec files (same as Java)
output_mr() {
    output_java
}

# ============================================================================
# Argument Parsing
# ============================================================================
while [[ $# -gt 0 ]]; do
    case "$1" in
        -b|--backend)
            if [[ -z "$2" || "$2" == -* ]]; then
                log_error "Backend option requires an argument (jml, dafny, or auto)"
                exit 1
            fi
            BACKEND="$2"
            if [[ "$BACKEND" != "jml" && "$BACKEND" != "dafny" && "$BACKEND" != "auto" ]]; then
                log_error "Invalid backend: $BACKEND. Must be 'jml', 'dafny', or 'auto'"
                exit 1
            fi
            shift 2
            ;;
        -m|--mode)
            if [[ -z "$2" || "$2" == -* ]]; then
                log_error "Mode option requires an argument"
                exit 1
            fi
            MODE="$2"
            if [[ "$MODE" != "full" && "$MODE" != "preproc" && "$MODE" != "mrderive" && "$MODE" != "compile" ]]; then
                log_error "Invalid mode: $MODE. Must be 'full', 'preproc', 'mrderive', or 'compile'"
                exit 1
            fi
            shift 2
            ;;
        -o|--output)
            if [[ -z "$2" || "$2" == -* ]]; then
                log_error "Output option requires a file argument"
                exit 1
            fi
            OUTPUT_FILE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        -*)
            log_error "Unknown option: $1"
            usage
            ;;
        *)
            INPUT_FILE="$1"
            shift
            ;;
    esac
done

# Validate input file
if [[ -z "$INPUT_FILE" ]]; then
    log_error "No input file specified"
    usage
fi

if [[ ! -f "$INPUT_FILE" ]]; then
    log_error "Input file not found: $INPUT_FILE"
    exit 1
fi

# ============================================================================
# Resolve Backend and Input Type
# ============================================================================
if [[ "$BACKEND" == "auto" ]]; then
    BACKEND=$(detect_backend "$INPUT_FILE")
    log_info "Auto-detected backend: $BACKEND (from $(basename "$INPUT_FILE"))"
fi

INPUT_TYPE=$(detect_input_type "$INPUT_FILE")

# ============================================================================
# Setup Paths
# ============================================================================
filename=$(basename "$INPUT_FILE")
index="${filename%.*}"
folder=$(dirname "$INPUT_FILE")

case "$INPUT_TYPE" in
    mr)
        MR_DIR="$folder"
        PROJECT_FOLDER=$(dirname "$folder")
        if [[ "$(basename "$folder")" == "tmp" ]]; then
            output_dir=$(get_output_dir "$PROJECT_FOLDER" "$BACKEND")
        else
            output_dir=$(get_output_dir "$folder" "$BACKEND")
        fi
        ;;
    dfy)
        MR_DIR="$folder/tmp"
        output_dir="$folder"
        ;;
    *)
        MR_DIR="$folder/tmp"
        output_dir=$(get_output_dir "$folder" "$BACKEND")
        ;;
esac

output_ext=$(get_output_extension "$BACKEND")

# Set default output file for dfy
if [[ "$INPUT_TYPE" == "dfy" && -z "$OUTPUT_FILE" ]]; then
    OUTPUT_FILE="${folder}/${index}.translated.dfy"
fi

log_info "Input: $INPUT_FILE (type: $INPUT_TYPE)"
log_info "Backend: $BACKEND"
log_info "Mode: $MODE"

# ============================================================================
# Clean up based on mode
# ============================================================================
# For MR input, don't delete the input files
if [[ "$INPUT_TYPE" != "mr" ]]; then
    if [[ "$MODE" == "full" ]]; then
        rm -f "$MR_DIR/"* 2>/dev/null || true
        if [[ "$INPUT_TYPE" != "dfy" ]]; then
            rm -f "$output_dir/"* 2>/dev/null || true
        fi
    elif [[ "$MODE" == "mrderive" ]]; then
        rm -f "$MR_DIR/"* 2>/dev/null || true
    fi
fi

# ============================================================================
# Unified Main Pipeline
# ============================================================================

# Stage 1: Extract annotations
if [[ "$MODE" == "preproc" || "$MODE" == "mrderive" || "$MODE" == "full" || "$MODE" == "compile" ]]; then
    if ! extract_annotations; then
        if [[ "$MODE" == "preproc" ]]; then
            exit 0
        fi
        log_error "Stage 1 FAILED"
        exit 1
    fi
fi

# For preproc mode, we're done after extraction
if [[ "$MODE" == "preproc" ]]; then
    log_info "Preprocessing complete."
    tbl_print
    exit 0
fi

# Stage 2: Preprocess annotations
if [[ "$MODE" == "mrderive" || "$MODE" == "full" ]]; then
    # For MR input, skip preprocessing (MR files are already ready)
    if [[ "$INPUT_TYPE" != "mr" ]]; then
        preprocess_annotations
    fi
fi

# Stage 3: MR derivation
if [[ "$MODE" == "mrderive" || "$MODE" == "full" ]]; then
    # For MR input, skip MR derivation (already have MR files)
    if [[ "$INPUT_TYPE" != "mr" ]]; then
        if ! derive_mrs; then
            tbl_print
            exit 1
        fi
    fi
fi

# For mrderive mode, we're done after MR derivation
if [[ "$MODE" == "mrderive" ]]; then
    log_info "MR derivation complete."
    tbl_print
    exit 0
fi

# Stage 4: Compilation
if [[ "$MODE" == "compile" || "$MODE" == "full" ]]; then
    if ! compile_annotations; then
        tbl_print
        exit 1
    fi
fi

# Stage 5: Output
if [[ "$MODE" == "compile" || "$MODE" == "full" ]]; then
    output_results
fi

# Print final table status
tbl_print

log_info "Done."
