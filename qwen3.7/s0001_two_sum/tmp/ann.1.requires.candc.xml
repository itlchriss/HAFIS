<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP\NP">
  <rule type="lex" cat="NP\NP">
   <rule type="fc" cat="S[dcl]/NP">
    <rule type="tr" cat="S[X]/(S[X]\NP)">
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="0" span="1" word="All" lemma="all" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="1" span="1" word="values" lemma="value" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="2" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="4" span="1" word="integer" lemma="integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="5" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="6" span="1" word="parameter" lemma="parameter" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="7" span="1" word="`numbers`" lemma="`numbers`" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="fc" cat="(S[dcl]\NP)/NP">
     <lf start="8" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="ba" cat="NP/NP">
      <lf start="9" span="1" word="greater" lemma="greater" pos="JJR" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
      <lf start="10" span="1" word="than" lemma="than" pos="IN" chunk="I-ADJP" entity="O" cat="(NP/NP)\(S[adj]\NP)" />
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="conj" cat="(NP\NP)\(NP\NP)">
   <lf start="11" span="1" word="or" lemma="or" pos="CC" chunk="I-ADJP" entity="O" cat="conj" />
   <rule type="ba" cat="NP\NP">
    <rule type="lex" cat="NP\NP">
     <rule type="fa" cat="S[adj]\NP">
      <lf start="12" span="1" word="equal" lemma="equal" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/PP" />
      <rule type="fa" cat="PP">
       <lf start="13" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
       <rule type="lex" cat="NP">
        <lf start="14" span="1" word="-1000000000" lemma="-1000000000" pos="CD" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="conj" cat="(NP\NP)\(NP\NP)">
     <lf start="15" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="lex" cat="NP\NP">
      <rule type="rp" cat="S[dcl]\NP">
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="16" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
        <rule type="fa" cat="S[adj]\NP">
         <rule type="ba" cat="(S[adj]\NP)/NP">
          <rule type="fc" cat="(S[adj]\NP)/NP">
           <lf start="17" span="1" word="less" lemma="less" pos="JJR" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/PP" />
           <lf start="18" span="1" word="than" lemma="than" pos="IN" chunk="I-ADJP" entity="O" cat="PP/NP" />
          </rule>
          <rule type="conj" cat="((S[adj]\NP)/NP)\((S[adj]\NP)/NP)">
           <lf start="19" span="1" word="or" lemma="or" pos="CC" chunk="I-ADJP" entity="O" cat="conj" />
           <rule type="fc" cat="(S[adj]\NP)/NP">
            <lf start="20" span="1" word="equal" lemma="equal" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/PP" />
            <lf start="21" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
           </rule>
          </rule>
         </rule>
         <rule type="lex" cat="NP">
          <lf start="22" span="1" word="1000000000" lemma="1000000000" pos="CD" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <lf start="23" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
