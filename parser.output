   30 argument: IDENTIFIER
   31         | terms

   32 event_term: '(' EVENT '(' IDENTIFIER ')' EQUAL IDENTIFIER ')'

   33 quantified_term: KEYWORD_QUANTIFIER IDENTIFIER '.' '(' terms ')'


